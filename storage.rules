rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // -----------------------------------------------------------------------
    // LEGACY paths. The files were deliberately NOT moved — the documents
    // copied into the new tree still point here — so these stay readable to
    // the people entitled to them, and frozen against new writes. Club media
    // is gated by the membership claim; the one existing reading log by its
    // owner's email.
    //
    // Locking `recordings/` is the point of the change: a stored public URL
    // no longer resolves for a stranger, while a member still gets the file
    // through getDownloadURL, which carries their token.
    // -----------------------------------------------------------------------

    match /recordings/{allPaths=**} {
      allow read: if inClub('flamingo');
      allow write: if false;
    }

    match /transcripts/{allPaths=**} {
      allow read: if inClub('flamingo');
      allow write: if false;
    }

    match /voice-notes/{allPaths=**} {
      allow read: if isOwner('doussinague95@gmail.com');
      allow write: if false;
    }

    // Voiceprints: the diarization experiment, long since removed.
    match /voiceprints/{allPaths=**} {
      allow read: if inClub('flamingo');
      allow write: if false;
    }

    // Book covers stay public-read: a jacket is not personal data, and
    // per-card signed URLs flicker on a grid. Writing needs a club.
    match /covers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // -----------------------------------------------------------------------
    // The live paths: club-scoped media and per-user voice notes.
    //
    // Storage rules cannot read Firestore, so club membership arrives as a
    // custom claim: { clubs: { flamingo: 'admin', otro: 'member' } }, kept in
    // sync by the syncClubClaims trigger. Claims go stale until the client
    // refreshes its token, which is why joining refreshes it explicitly.
    // -----------------------------------------------------------------------

    // Both key tests use `in`: reading an absent property off the token throws
    // instead of returning null, and a user who belongs to no club has no
    // `clubs` claim at all. The throw would still deny, but by accident.
    function inClub(clubId) {
      return request.auth != null
        && 'clubs' in request.auth.token
        && clubId in request.auth.token.clubs;
    }

    function isOwner(email) {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email;
    }

    match /clubs/{clubId}/recordings/{allPaths=**} {
      allow read: if inClub(clubId);
      allow write: if inClub(clubId)
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // Written only by the Cloud Function (Admin SDK bypasses rules).
    match /clubs/{clubId}/transcripts/{allPaths=**} {
      allow read: if inClub(clubId);
      allow write: if false;
    }

    // Personal audio, private to its owner — never world-readable, unlike
    // club recordings.
    match /users/{email}/voice-notes/{allPaths=**} {
      allow read: if isOwner(email);
      allow write: if isOwner(email)
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
